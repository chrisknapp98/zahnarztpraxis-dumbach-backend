# Local configuration. Keep .env out of version control.
# Copy to .env and fill in both secrets before starting Docker.
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"

# Application
DJANGO_SECRET_KEY=
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — local Python connects via localhost; Compose overrides host and port for web.
POSTGRES_DB=dumbach
POSTGRES_USER=dumbach
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_PASSWORD=

# VS Code / Django test discovery
MANAGE_PY_PATH=./manage.py
